# =====================================================================
# MICR_Project — Variables de connexion à la base micr_db
# Fichier : database/.env.example  (MODELE — ne contient aucun secret)
# ---------------------------------------------------------------------
# Copier ce fichier vers .env A LA RACINE du projet, puis le remplir :
#
#   cp database/.env.example .env
#
# Le fichier .env est ignoré par Git (voir .gitignore). Il ne doit
# JAMAIS être commité : il contient le mot de passe MySQL.
# =====================================================================

# --- Connexion MySQL -------------------------------------------------
DB_NAME=micr_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Production ------------------------------------------------------
# Ne pas utiliser root sur le VPS. Créer un compte applicatif dédié,
# limité à SELECT/INSERT/UPDATE/DELETE (voir README.md section 9) :
#
#   DB_USER=micr_user
#   DB_PASSWORD=<mot de passe fort, généré>
